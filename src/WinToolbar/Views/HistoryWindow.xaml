<Window x:Class="WinToolbar.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riwayat pemakaian WiFi" Width="760" Height="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Total per WiFi" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListView Grid.Row="1" x:Name="TotalsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="WiFi" Width="240" DisplayMemberBinding="{Binding Ssid}" />
                    <GridViewColumn Header="Sesi" Width="60" DisplayMemberBinding="{Binding Sessions}" />
                    <GridViewColumn Header="Download" Width="110" DisplayMemberBinding="{Binding Down}" />
                    <GridViewColumn Header="Upload" Width="110" DisplayMemberBinding="{Binding Up}" />
                    <GridViewColumn Header="Total" Width="110" DisplayMemberBinding="{Binding Total}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Text="Sesi" FontWeight="SemiBold" Margin="0,14,0,6" />
        <ListView Grid.Row="3" x:Name="SessionsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="WiFi" Width="180" DisplayMemberBinding="{Binding Ssid}" />
                    <GridViewColumn Header="Mulai" Width="140" DisplayMemberBinding="{Binding Started}" />
                    <GridViewColumn Header="Durasi" Width="90" DisplayMemberBinding="{Binding Duration}" />
                    <GridViewColumn Header="Download" Width="95" DisplayMemberBinding="{Binding Down}" />
                    <GridViewColumn Header="Upload" Width="95" DisplayMemberBinding="{Binding Up}" />
                    <GridViewColumn Header="Total" Width="95" DisplayMemberBinding="{Binding Total}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
