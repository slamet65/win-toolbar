<UserControl x:Class="WinToolbar.Widgets.QuotaMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand" Background="Transparent"
             MouseLeftButtonUp="OnClick">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Margin="10,0">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE701;" FontSize="13" Margin="0,1,6,0" />
        <TextBlock x:Name="SsidText" FontWeight="SemiBold" Text="Tidak ada WiFi" />
        <StackPanel x:Name="UsagePanel" Orientation="Horizontal" Visibility="Collapsed">
            <!-- Kecepatan saat ini. Lebar tetap supaya isi bar tidak bergeser tiap detik. -->
            <TextBlock Text="↓" Foreground="#6CCB5F" Margin="14,0,3,0" />
            <TextBlock x:Name="SpeedDownText" MinWidth="62" />
            <TextBlock Text="↑" Foreground="#60CDFF" Margin="6,0,3,0" />
            <TextBlock x:Name="SpeedUpText" MinWidth="62" />
            <!-- Pemakaian sesi. -->
            <TextBlock Text="Sesi" Foreground="#9A9A9A" Margin="10,0,0,0" />
            <TextBlock Text="↓" Foreground="#6CCB5F" Margin="6,0,3,0" />
            <TextBlock x:Name="DownText" />
            <TextBlock Text="↑" Foreground="#60CDFF" Margin="10,0,3,0" />
            <TextBlock x:Name="UpText" />
            <TextBlock Text="Total" Foreground="#9A9A9A" Margin="14,0,5,0" />
            <TextBlock x:Name="TotalText" FontWeight="SemiBold" />
            <TextBlock x:Name="DurationText" Foreground="#9A9A9A" Margin="14,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
